# Postgres connection string, e.g. postgres://user:password@host:5432/dbname
DATABASE_URI=

# Set to "true" if the database requires SSL (most managed Postgres do)
DATABASE_SSL=false

# Any long random string — used to sign Payload's cookies/tokens
PAYLOAD_SECRET=

# The public URL this app is served from (used for CORS/CSRF and admin links)
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# S3-compatible storage for uploaded media (the app's own filesystem is wiped
# on every deploy). Leave unset in local dev to use local disk instead.
S3_BUCKET=
S3_ENDPOINT=https://s3.twcstorage.ru
S3_REGION=ru-1
S3_ACCESS_KEY=
S3_SECRET_KEY=
